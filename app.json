{
  "expo": {
    "name": "PediaCare",
    "slug": "pediacare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pediacare",
    "backgroundColor": "#FFF0EC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pediacare.app"
    },
    "android": {
      "package": "com.pediacare.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF0EC",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF0EC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
